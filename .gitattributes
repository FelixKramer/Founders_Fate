# Normalize line endings across Windows + macOS + Linux contributors.
* text=auto eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.mov binary

# Generated / vendored
app/.next/** linguist-generated=true
services/mirofish/** linguist-vendored=true
