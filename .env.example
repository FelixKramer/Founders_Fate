# ============================================================
# Founder Fate — environment variables (root)
# ------------------------------------------------------------
# Copy to `.env` (root) for docker-compose, and to `app/.env.local`
# for `next dev`. Never commit real secrets.
# ============================================================

# -------- Database --------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/founderfate
# Local dev fallback (boilerplate default; switch back to Postgres for parity)
# DATABASE_URL=file:./dev.db

# -------- NextAuth --------
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# -------- OAuth providers --------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional (boilerplate also supports GitHub)
GITHUB_ID=
GITHUB_SECRET=

# -------- Stripe --------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -------- MiroFish (internal sim service) --------
MIROFISH_URL=http://localhost:8000
# Shared bearer used for Next.js <-> MiroFish auth on the internal network.
# Generate: openssl rand -hex 32
MIROFISH_INTERNAL_TOKEN=dev-internal-token-change-me

# -------- LLM gateway (OpenRouter primary) --------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=FounderFate
# Optional direct keys — gateway uses these as fallback if OpenRouter is down.
# Configure in services/mirofish/config/llm-routing.yaml under `direct_fallback`.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Modes: live | mock — mock returns deterministic fixtures, no LLM calls
LLM_GATEWAY_MODE=live

# -------- Zep Cloud (graph memory) --------
ZEP_API_KEY=
ZEP_BASE_URL=https://api.getzep.com

# -------- Cache & rate-limit (Upstash Redis serverless) --------
# Used by Next.js. MiroFish uses local Redis (REDIS_URL below) in dev,
# Upstash in prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local Redis for docker-compose (MiroFish container points here)
REDIS_URL=redis://localhost:6379/0

# -------- Security --------
# Generate: openssl rand -hex 32
SERVER_SECRET=change-me-openssl-rand-hex-32
# Generate: openssl rand -hex 32
EMAIL_INDEX_PEPPER=change-me-openssl-rand-hex-32

# -------- Observability --------
SENTRY_DSN=
AMPLITUDE_KEY=

# -------- Admin --------
# Comma-separated emails auto-promoted to `admin` role on first signup.
# After bootstrap, grant additional admins via the /admin UI.
ADMIN_EMAILS=
# One-time grant token used by scripts/grant-admin.ts if the admin UI is unavailable.
ADMIN_BOOTSTRAP_TOKEN=

# -------- Email (re-engagement, transactional) --------
# Pick one — Resend is the default.
RESEND_API_KEY=
EMAIL_FROM=hello@founderfate.ai
